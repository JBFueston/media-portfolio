---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import 'photoswipe/style.css';
import '../styles/global.css';

const galleryItems = await getCollection('gallery');
galleryItems.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const subjects = [...new Set(galleryItems.flatMap((i) => i.data.tags))].sort();
const legendColors = ['bg-gold', 'bg-teal', 'bg-rose', 'bg-sage'];
const frame = (n: number) => String(n).padStart(3, '0');
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Gallery | JB Fueston</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  </head>
  <body class="bg-ink text-paper font-body min-h-screen antialiased">

    <header class="sticky top-0 z-40 backdrop-blur-md bg-ink/85 border-b border-line px-6 py-5">
      <div class="max-w-7xl mx-auto flex flex-col lg:flex-row lg:items-center justify-between gap-4">

        <div class="flex items-center gap-8">
          <a href="/" class="w-fit block">
            <h1 class="font-display text-2xl font-medium tracking-tight text-paper">
              JB Fueston
            </h1>
          </a>
          <nav class="flex items-center gap-5 border-l border-line pl-6">
            <a href="/" class="text-sm font-medium text-muted hover:text-paper transition-colors">Stories</a>
            <a href="/gallery" class="text-sm font-medium text-paper border-b-2 border-gold pb-0.5">Gallery</a>
          </nav>
        </div>

        <div class="flex items-center gap-5" id="filter-buttons">
          <button data-filter="all" class="filter-btn active text-xs font-medium text-paper pb-1 border-b-2 border-gold transition-colors">
            All
          </button>
          <button data-filter="photo" class="filter-btn text-xs font-medium text-muted hover:text-paper pb-1 border-b-2 border-transparent transition-colors">
            Photos
          </button>
          <button data-filter="video" class="filter-btn text-xs font-medium text-muted hover:text-paper pb-1 border-b-2 border-transparent transition-colors">
            Videos
          </button>
        </div>
      </div>

      {subjects.length > 0 && (
        <div class="max-w-7xl mx-auto flex items-center gap-x-5 gap-y-2 flex-wrap mt-4 pt-4 border-t border-line">
          <button data-subject="all" class="subject-btn active flex items-center gap-2 text-xs font-medium text-paper pb-1 border-b-2 border-gold transition-colors">
            <span class="w-1.5 h-1.5 rounded-full bg-gold"></span>
            All subjects
          </button>
          {subjects.map((s, i) => (
            <button data-subject={s} class="subject-btn flex items-center gap-2 text-xs font-medium text-muted hover:text-paper pb-1 border-b-2 border-transparent transition-colors">
              <span class={`w-1.5 h-1.5 rounded-full ${legendColors[i % legendColors.length]}`}></span>
              {s}
            </button>
          ))}
        </div>
      )}
    </header>

    <main class="max-w-7xl mx-auto px-6 py-10">
      <div id="gallery" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {galleryItems.map((item, i) => (
          <article
            class="gallery-item group relative rounded-sm overflow-hidden bg-surface border border-line hover:border-gold/40 transition-colors duration-300"
            data-category={item.data.type}
            data-subjects={item.data.tags.join(' ')}
          >
            {item.data.type === 'photo' ? (
              <a
                href={item.data.coverImage.src}
                data-pswp-width={item.data.coverImage.width}
                data-pswp-height={item.data.coverImage.height}
                target="_blank"
                class="block relative aspect-[4/3] overflow-hidden bg-ink cursor-zoom-in"
              >
                <Image
                  src={item.data.coverImage}
                  alt={item.data.title}
                  width={800}
                  quality="high"
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                />

                <span class="absolute top-2 left-2 font-mono text-[9px] text-paper/70 bg-ink/50 px-1.5 py-0.5 rounded-[2px] z-10">
                  {frame(galleryItems.length - i)}
                </span>

                <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-5 pointer-events-none">
                  <span class="text-xs font-medium text-paper">
                    Expand photo
                  </span>
                </div>
              </a>
            ) : (
              <div class="relative aspect-[4/3] bg-ink overflow-hidden">
                <span class="absolute top-2 left-2 font-mono text-[9px] text-paper/70 bg-ink/50 px-1.5 py-0.5 rounded-[2px] z-10">
                  {frame(galleryItems.length - i)}
                </span>
                <video
                  controls
                  poster={item.data.coverImage.src}
                  class="absolute inset-0 w-full h-full object-cover"
                  preload="none"
                >
                  <source src={item.data.videoUrl} type="video/mp4" />
                </video>
              </div>
            )}

            <div class="p-4 border-t border-line">
              <h2 class="text-sm font-medium text-paper group-hover:text-gold transition-colors truncate">
                {item.data.title}
              </h2>
              <div class="flex items-center gap-3 text-xs mt-1.5">
                <span class="text-paper/70">{item.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                {item.data.location && (
                  <span class="text-muted border-l border-line pl-3 truncate">{item.data.location}</span>
                )}
              </div>
              {item.data.device && (
                <p class="font-mono text-[10px] text-muted/80 mt-1.5">{item.data.device}</p>
              )}
            </div>
          </article>
        ))}
      </div>
    </main>

    <footer class="max-w-7xl mx-auto px-6 py-12 border-t border-line flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-muted">
      <p>© {new Date().getFullYear()} JB Fueston. Built with Astro & Vercel.</p>

      <div class="flex items-center gap-4">
        <a href="https://jbfueston.com" class="hover:text-gold transition-colors">Main site</a>
        <a href="https://github.com/YOUR-GITHUB" class="hover:text-gold transition-colors">GitHub</a>
        <a href="https://instagram.com/YOUR-HANDLE" class="hover:text-gold transition-colors">Instagram</a>
      </div>
    </footer>

    <script>
      import PhotoSwipeLightbox from 'photoswipe/lightbox';

      const lightbox = new PhotoSwipeLightbox({
        gallery: '#gallery',
        children: 'a[data-pswp-width]',
        pswpModule: () => import('photoswipe')
      });
      lightbox.init();

      const filterButtons = document.querySelectorAll<HTMLElement>('.filter-btn');
      const subjectButtons = document.querySelectorAll<HTMLElement>('.subject-btn');
      const galleryItems = document.querySelectorAll<HTMLElement>('.gallery-item');

      let activeType = 'all';
      let activeSubject = 'all';

      function applyFilters() {
        galleryItems.forEach((item) => {
          const typeMatch = activeType === 'all' || item.dataset.category === activeType;
          const subjects = (item.dataset.subjects || '').split(' ');
          const subjectMatch = activeSubject === 'all' || subjects.includes(activeSubject);
          item.style.display = typeMatch && subjectMatch ? 'block' : 'none';
        });
      }

      filterButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          activeType = btn.getAttribute('data-filter') || 'all';

          filterButtons.forEach((b) => {
            b.classList.remove('text-paper', 'border-gold');
            b.classList.add('text-muted', 'border-transparent');
          });
          btn.classList.remove('text-muted', 'border-transparent');
          btn.classList.add('text-paper', 'border-gold');

          applyFilters();
        });
      });

      subjectButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          activeSubject = btn.getAttribute('data-subject') || 'all';

          subjectButtons.forEach((b) => {
            b.classList.remove('text-paper', 'border-gold');
            b.classList.add('text-muted', 'border-transparent');
          });
          btn.classList.remove('text-muted', 'border-transparent');
          btn.classList.add('text-paper', 'border-gold');

          applyFilters();
        });
      });
    </script>
  </body>
</html>