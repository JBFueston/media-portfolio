---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import 'photoswipe/style.css';
import '../../styles/global.css';

// 1. Tell Astro which static pages to generate at build time
export async function getStaticPaths() {
  const posts = await getCollection('journal');

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

// 2. Extract props and render the Markdown content
const { post } = Astro.props;
const { Content } = await render(post);
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{post.data.title} | JB Fueston</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  </head>
  <body class="bg-ink text-paper font-body min-h-screen antialiased">

    <header class="sticky top-0 z-40 backdrop-blur-md bg-ink/85 border-b border-line px-6 py-5">
      <div class="max-w-3xl mx-auto flex items-center justify-between">
        <a href="/" class="text-sm font-medium text-muted hover:text-paper transition-colors">
          Back to stories
        </a>
        <a href="/gallery" class="text-sm font-medium text-muted hover:text-paper transition-colors">
          Gallery
        </a>
      </div>
    </header>

    <main class="max-w-3xl mx-auto px-6 py-14">
      <header class="mb-8">
        <h1 class="font-display text-3xl sm:text-5xl font-medium tracking-tight text-paper mb-3 leading-[1.1]">{post.data.title}</h1>
        <div class="flex items-center gap-3 text-xs">
          <span class="text-gold font-medium">
            {post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
          </span>
          {post.data.location && (
            <span class="text-muted border-l border-line pl-3">{post.data.location}</span>
          )}
        </div>
      </header>

      <div class="rounded-sm overflow-hidden border border-line mb-10 relative">
        <Image
          src={post.data.coverImage}
          alt={post.data.title}
          width={1400}
          quality="high"
          class="w-full h-auto object-cover"
        />
        {post.data.device && (
          <span class="absolute bottom-2 left-2 font-mono text-[10px] text-paper/70 bg-ink/50 px-1.5 py-0.5 rounded-[2px]">
            {post.data.device}
          </span>
        )}
      </div>

      <article class="prose prose-invert prose-neutral max-w-none text-paper/80 leading-relaxed space-y-4">
        <Content />
      </article>

      <!-- Mini Gallery Block -->
      {post.data.gallery && post.data.gallery.length > 0 && (
        <section class="mt-12 pt-8 border-t border-line" id="post-gallery">
          <h2 class="font-display text-xl font-medium text-paper mb-6">Session Stills</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {post.data.gallery.map((img) => (
              <a
                href={img.src}
                data-pswp-width={img.width}
                data-pswp-height={img.height}
                target="_blank"
                class="block rounded-sm overflow-hidden border border-line bg-ink group cursor-zoom-in relative"
              >
                <Image
                  src={img}
                  alt="Session Still"
                  width={800}
                  class="w-full h-48 object-cover group-hover:scale-105 transition duration-500"
                />
              </a>
            ))}
          </div>
        </section>
      )}

      {post.data.tags.length > 0 && (
        <div class="flex items-center gap-x-5 gap-y-2 flex-wrap mt-10 pt-6 border-t border-line">
          {post.data.tags.map((tag, i) => (
            <span class="flex items-center gap-2 text-xs text-muted">
              <span class={`w-1.5 h-1.5 rounded-full ${['bg-gold', 'bg-teal', 'bg-rose', 'bg-sage'][i % 4]}`}></span>
              {tag}
            </span>
          ))}
        </div>
      )}
    </main>

    <footer class="max-w-3xl mx-auto px-6 py-12 border-t border-line text-center text-xs text-muted">
      <p>© {new Date().getFullYear()} JB Fueston</p>
    </footer>

    <!-- PhotoSwipe Script -->
    <script>
      import PhotoSwipeLightbox from 'photoswipe/lightbox';

      const lightbox = new PhotoSwipeLightbox({
        gallery: '#post-gallery',
        children: 'a',
        pswpModule: () => import('photoswipe')
      });
      lightbox.init();
    </script>
  </body>
</html>