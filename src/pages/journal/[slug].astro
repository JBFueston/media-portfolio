---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import '../../styles/global.css';

// 1. Tell Astro which static pages to generate at build time
export async function getStaticPaths() {
  const posts = await getCollection('journal');
  
  return posts.map((post) => ({
    params: { slug: post.id }, // Matches the [slug] parameter in the filename
    props: { post },           // Passes the full post entry as a prop
  }));
}

// 2. Extract props and render the Markdown content
const { post } = Astro.props;
const { Content } = await render(post);
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{post.data.title} | JB Fueston</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#0b0c0e] text-neutral-100 font-['Plus_Jakarta_Sans',sans-serif] min-h-screen antialiased">
    
    <header class="sticky top-0 z-40 backdrop-blur-xl bg-[#0b0c0e]/80 border-b border-white/5 px-6 py-5">
      <div class="max-w-4xl mx-auto flex items-center justify-between">
        <a href="/" class="text-xs font-semibold text-neutral-400 hover:text-white transition flex items-center gap-1">
          ← Back to Stories
        </a>
        <a href="/gallery" class="text-xs font-medium text-neutral-400 hover:text-white transition">
          Master Gallery ↗
        </a>
      </div>
    </header>

    <main class="max-w-4xl mx-auto px-6 py-12">
      <header class="mb-8">
        <div class="flex items-center gap-2 mb-3">
          {post.data.device && (
            <span class="text-[10px] uppercase font-mono tracking-wider px-2.5 py-1 rounded-full bg-white/10 text-neutral-200 border border-white/10">
              {post.data.device}
            </span>
          )}
          {post.data.location && (
            <span class="text-xs text-neutral-400">• {post.data.location}</span>
          )}
        </div>
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-white mb-2">{post.data.title}</h1>
        <time class="text-xs text-neutral-400">
          {post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
        </time>
      </header>

      <div class="rounded-2xl overflow-hidden border border-white/10 mb-10 shadow-2xl">
        <Image 
          src={post.data.coverImage} 
          alt={post.data.title} 
          width={1400} 
          quality="high" 
          class="w-full h-auto object-cover" 
        />
      </div>

      <article class="prose prose-invert prose-neutral max-w-none text-neutral-300 leading-relaxed space-y-4">
        <Content />
      </article>
    </main>

    <footer class="max-w-4xl mx-auto px-6 py-12 border-t border-white/5 text-center text-xs text-neutral-500">
      <p>© {new Date().getFullYear()} JB Fueston</p>
    </footer>
  </body>
</html>